# Public canonical origin; set to the real HTTPS domain before enabling indexing.
VITE_SITE_URL=
VITE_INDEXING_ENABLED=false

# Ads are disabled unless explicitly enabled with real approved account/slot values.
VITE_ADS_ENABLED=false
VITE_AD_PROVIDER=
VITE_ADSENSE_CLIENT=
VITE_AD_SLOT_HOME=
VITE_AD_SLOT_BOOK_DETAIL=
VITE_AD_SLOT_CHAPTER_END=

# Domestic adapter contract: script must be HTTPS and its host must be allowlisted.
VITE_DOMESTIC_AD_SCRIPT_URL=
VITE_AD_ALLOWED_HOSTS=
VITE_DOMESTIC_AD_SLOT_HOME=
VITE_DOMESTIC_AD_SLOT_BOOK_DETAIL=
VITE_DOMESTIC_AD_SLOT_CHAPTER_END=

# Keep CMP required by default. Configure only after choosing/integrating a real CMP.
VITE_CMP_REQUIRED=true
VITE_CONTACT_EMAIL=
